# PostHog browser analytics configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# External screenshot service (ScreenshotOne) — fallback for sites that serve a
# bot challenge to the headless browser. Without a key the fallback stays inert.
SCREENSHOTONE_ACCESS_KEY=your_screenshotone_access_key
